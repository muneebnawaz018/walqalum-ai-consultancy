{
  "globs": ["**/*.md"],
  // Regenerated by `next dev`, so any fix here is undone on the next run.
  "ignores": ["node_modules", ".next", "AGENTS.md", "CLAUDE.md"],
  "config": {
    "MD013": {
      // Table rows and code samples cannot wrap without changing meaning.
      "tables": false,
      "code_blocks": false
    }
  }
}
