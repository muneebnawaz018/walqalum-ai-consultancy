{
  "name": "walqalum-ai-consultancy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:admin": "tsx --env-file=.env.development.local scripts/seed-admin.ts",
    "seed:demo": "tsx --env-file=.env.development.local scripts/seed-demo.ts",
    "db:up": "node --env-file=.env.development.local scripts/compose.mjs up -d",
    "db:down": "node --env-file=.env.development.local scripts/compose.mjs down",
    "db:logs": "node --env-file=.env.development.local scripts/compose.mjs logs -f mongo",
    "test": "node --import tsx --test --env-file=.env.development.local tests/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "mongodb": "^7.5.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
