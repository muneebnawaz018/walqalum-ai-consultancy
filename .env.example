# Copy this to .env.development.local and fill in every blank. That is the file
# Next loads for `next dev`, and the one the db, seed and test scripts point at.
# It is gitignored; this template is the only env file that gets committed, so
# every value below is a placeholder and none of them are real.


# ---------------------------------------------------------------------------
# The app itself. These four are all a deployment needs.
# ---------------------------------------------------------------------------

# Public site origin, used for canonicals, hreflang, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=https://walqalum.com

# The whole database config, local and hosted alike. On a host this is the
# cluster's connection string. Locally it is the container `npm run db:up`
# starts, which takes its root user from the credentials in here:
#   mongodb://<user>:<password>@127.0.0.1:27017/walqalum?authSource=admin
MONGODB_URI=

# Optional, defaults to "walqalum". Only set it if the database is named
# something else, which a hosted cluster's own URI usually already says.
MONGODB_DB=

# Session signing key, 32+ characters. Generate with: openssl rand -base64 48
AUTH_SECRET=


# ---------------------------------------------------------------------------
# Local development only. None of this belongs in a deployed environment.
# ---------------------------------------------------------------------------

# Set to `off` ONLY for the local integration tests, which would otherwise lock
# themselves out of sign-in. Ignored when NODE_ENV is production.
AUTH_RATE_LIMIT=

# The account both seeds create, and the one `npm test` signs in as. They refuse
# to run until the password is set, and refuse again if it is under 12
# characters. Generate one with: openssl rand -base64 24
# Arguments override these: npm run seed:admin -- <email> "<name>" <password>
SEED_EMAIL=marketing@walqalum.com
SEED_NAME=Marketing
SEED_PASSWORD=
